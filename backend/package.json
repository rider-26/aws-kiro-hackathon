{
  "name": "peerlink-nyp-backend",
  "version": "1.0.0",
  "description": "PeerLink NYP - Express API, runs locally and as an AWS Lambda function via serverless-http.",
  "main": "src/lambda.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "db:stats": "node scripts/dbStats.js",
    "db:users": "node scripts/listUsers.js",
    "provision:dynamo": "node scripts/provisionDynamo.js",
    "provision:dynamo:plan": "node scripts/provisionDynamo.js --dry-run",
    "smoke:api": "node scripts/apiSmokeTest.js",
    "smoke:ws": "node scripts/wsSmokeTest.js",
    "smoke:deepseek": "node scripts/deepseekSmokeTest.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.620.0",
    "@aws-sdk/client-dynamodb": "^3.620.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/lib-dynamodb": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "serverless-http": "^3.2.0",
    "uuid": "^9.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
