# Fill these in with the values of the resources you provision in AWS,
# then run `npm run deploy` from /infra to stand up the API.

CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=ap-southeast-1

# AWS Academy / Learner Lab credentials are TEMPORARY and include a session
# token. They expire every session, so these need re-pasting from the lab's
# "AWS Details" panel each time. Permanent IAM user keys don't need the token.
# (The AWS CLI/CDK read these from your shell or ~/.aws — listed here as a
# reminder of what `cdk deploy` needs, not as a place CDK reads them from.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# DynamoDB table names. CDK IMPORTS these — it does not create them.
# Create them first with `npm run provision:dynamo` in /backend, which builds
# all 22 tables and 28 indexes from backend/src/config/indexes.js.
TABLE_USERS=PeerLink_Users
TABLE_TUTOR_PROFILES=PeerLink_TutorProfiles
TABLE_MODULES=PeerLink_Modules
TABLE_TUTOR_VERIFICATIONS=PeerLink_TutorVerifications
TABLE_TUTOR_TOPICS=PeerLink_TutorTopics
TABLE_TUTOR_AVAILABILITY=PeerLink_TutorAvailability
TABLE_SAVED_TUTORS=PeerLink_SavedTutors
TABLE_BOOKINGS=PeerLink_Bookings
TABLE_SESSIONS=PeerLink_TutoringSessions
TABLE_SESSION_PARTICIPANTS=PeerLink_SessionParticipants
TABLE_CHAT_MESSAGES=PeerLink_ChatMessages
TABLE_STUDY_MATERIALS=PeerLink_StudyMaterials
TABLE_QUIZZES=PeerLink_Quizzes
TABLE_QUIZ_QUESTIONS=PeerLink_QuizQuestions
TABLE_QUIZ_ATTEMPTS=PeerLink_QuizAttempts
TABLE_QUIZ_RESPONSES=PeerLink_QuizResponses
TABLE_TOPIC_PERFORMANCE=PeerLink_TopicPerformance
TABLE_REVIEWS=PeerLink_Reviews
TABLE_USER_REPORTS=PeerLink_UserReports
TABLE_NOTIFICATIONS=PeerLink_Notifications
TABLE_RECOGNITION_RULES=PeerLink_RecognitionRules
TABLE_CONNECTIONS=PeerLink_Connections

# Existing S3 bucket name (must already exist)
S3_BUCKET=peerlink-nyp-uploads

# Existing IAM role ARN for Lambda execution (if you prefer to pre-create it yourself).
# Leave blank to let CDK create a new minimally-scoped role for the Lambda instead.
LAMBDA_EXECUTION_ROLE_ARN=

# Secrets passed through as Lambda environment variables (consider AWS Secrets Manager for production)
JWT_SECRET=
DEEPSEEK_API_KEY=
FRONTEND_ORIGIN=https://your-app.amplifyapp.com
