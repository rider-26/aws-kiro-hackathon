# REST API base URL.
# Local dev: http://localhost:5000/api
# Deployed:  the RestApiUrl output from `cdk deploy` (already ends in /api)
VITE_API_BASE_URL=http://localhost:5000/api

# WebSocket URL for live notifications and session chat.
# Local dev: ws://localhost:5000/ws
# Deployed:  the WebSocketUrl output from `cdk deploy`
VITE_WS_URL=ws://localhost:5000/ws
